<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e0e0e0; -fx-border-radius: 8px;" stylesheets="@estilos.css" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="179.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReporteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a252f;" text="Gestión de Reportes" />

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <ComboBox fx:id="cmbTipoReporte" id="cmb-tipo-reporte" prefWidth="210.0" promptText="Seleccionar tipo de reporte" />
                <DatePicker fx:id="dpDesde" id="dp-desde" prefWidth="140.0" promptText="Desde" />
                <DatePicker fx:id="dpHasta" id="dp-hasta" prefWidth="140.0" promptText="Hasta" />

                <Button fx:id="btnGenerar" id="btn-generar" onAction="#onGenerarReporte"
                        style="-fx-background-color: rgba(15, 156, 45, 1); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="Generar" />
            </children>
        </HBox>

        <TableView fx:id="tblReporte" id="tbl-reporte" prefHeight="280.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="col1" id="col-1" prefWidth="100.0" text="ID / Fecha" />
                <TableColumn fx:id="col2" id="col-2" prefWidth="220.0" text="Descripción / Producto" />
                <TableColumn fx:id="col3" id="col-3" prefWidth="120.0" text="Monto / Cantidad" />
                <TableColumn fx:id="col4" id="col-4" prefWidth="120.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="btnExportar" id="btn-exportar" onAction="#onExportarPDF"
                        style="-fx-background-color: rgba(14, 52, 92, 1); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="Exportar a PDF" />
            </children>
        </HBox>
    </children>
</VBox>