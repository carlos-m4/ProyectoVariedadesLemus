      <Label layoutX="42.0" layoutY="285.0" text="Precio de compra">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField id="btn_precio_produtc_venta" fx:id="btnprecio_product_venta" alignment="TOP_LEFT" layoutX="248.0" layoutY="312.0" onAction="#on_precio_product_venta" prefHeight="27.0" prefWidth="179.0" promptText="\$ 0.00" />
      <Label layoutX="248.0" layoutY="285.0" text="Precio de venta">
