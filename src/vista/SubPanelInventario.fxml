      <TextField id="txtDescrip" fx:id="DescripProductADDP" layoutX="42.0" layoutY="225.0" onAction="#on_descripcion_product" prefHeight="45.0" prefWidth="658.0" promptText="Escribe una breve descripcion del producto (opcional)" />
