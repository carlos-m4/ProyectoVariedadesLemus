      </Label>
      <TextField id="btnCategoria_product" fx:id="txtcodigo_produc11" alignment="TOP_LEFT" layoutX="498.0" layoutY="150.0" onAction="#on_categ_producto" prefHeight="27.0" prefWidth="209.0" promptText="Ingresa la categoria del producto" />
      <Label layoutX="498.0" layoutY="123.0" text="Categoria">
