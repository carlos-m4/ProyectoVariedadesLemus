      </Label>
      <Button id="btnGuardar_Producto" fx:id="btnGuardar_product" alignment="TOP_CENTER" layoutX="585.0" layoutY="399.0" mnemonicParsing="false" onAction="#onsave_product" prefHeight="27.0" prefWidth="129.0" style="-fx-background-color: rgba(15, 156, 45, 1); -fx-background-radius: 5;" text="Guardar producto" textFill="WHITE" wrapText="true" />
      <TextField id="btnCodigo_Product" fx:id="txtcodigo_produc" alignment="TOP_LEFT" editable="false" focusTraversable="false" layoutX="42.0" layoutY="150.0" onAction="#onCod" prefHeight="27.0" prefWidth="179.0" promptText="Automático" />
      <Label layoutX="42.0" layoutY="123.0" text="Codigo del producto">
