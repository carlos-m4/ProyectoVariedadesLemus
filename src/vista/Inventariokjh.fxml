<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.variedadeslemus.controller.InventarioController">

    <!-- MENÚ LATERAL IZQUIERDO -->
    <left>
        <VBox prefWidth="240.0" spacing="15.0" style="-fx-background-color: #0E345C;" BorderPane.alignment="CENTER">
            <children>
                <!-- Logo Corporativo -->
                <VBox alignment="CENTER" prefHeight="100.0" spacing="5.0">
                    <children>
                        <Label text="Variedades" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Lemus 🛒" textFill="#f59e0b">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Botones del Menú Lateral con sus id oficiales -->
                <Button fx:id="btnInicio" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🏠  Inicio" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                    <VBox.margin><Insets left="15.0" right="15.0" /></VBox.margin>
                </Button>

                <Button fx:id="btnInventario" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: #1D538A; -fx-background-radius: 8; -fx-cursor: hand;" text="📦  Inventario" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                    <VBox.margin><Insets left="15.0" right="15.0" /></VBox.margin>
                </Button>

                <Button fx:id="btnVentas" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🛍️  Ventas" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                    <VBox.margin><Insets left="15.0" right="15.0" /></VBox.margin>
                </Button>

                <Button fx:id="btnReportes" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-cursor: hand;" text="📊  Reportes" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                    <VBox.margin><Insets left="15.0" right="15.0" /></VBox.margin>
                </Button>

                <!-- Espaciador flexible para empujar Cerrar Sesión al final -->
                <AnchorPane VBox.vgrow="ALWAYS" />

                <Button fx:id="btnCerrarSesion" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🚪  Cerrar sesion" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                    <VBox.margin><Insets bottom="20.0" left="15.0" right="15.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- ÁREA PRINCIPAL DERECHA -->
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #F8FAFC;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>

                <!-- Encabezado con Título y Fecha del Sistema -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Gestion de inventario" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblFechaActual" text="📅 Lunes, 19 de Octubre de 2026" textFill="#64748b">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Barra Superior de Acciones (Agregar, Buscar y Filtrar) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="btnAgregarProducto" style="-fx-background-color: #22C55E; -fx-background-radius: 8; -fx-cursor: hand;" text="+ Agregar Producto" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>

                        <AnchorPane HBox.hgrow="ALWAYS" />

                        <!-- Buscador Inteligente -->
                        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="🔍 Buscar producto..." style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <padding>
                                <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                            </padding>
                        </TextField>

                        <!-- Filtro por Categoria -->
                        <ComboBox fx:id="cmbCategoria" prefWidth="180.0" promptText="Filtrar por categoría" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8;" />
                    </children>
                </HBox>

                <!-- Tabla de Productos (TableView) -->
                <TableView fx:id="tblProductos" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                        <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                        <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                        <TableColumn fx:id="colAcciones" prefWidth="100.0" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>